<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>FolioSlice</AssemblyName>
    <RootNamespace>Slice</RootNamespace>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="FluentAvaloniaUI" />
  </ItemGroup>
  <ItemGroup Condition="'$(TelemetryVariant)' == 'exclude'">
    <!-- A2 experiment: a direct reference with all assets excluded stops the transitive build task from being imported. -->
    <PackageReference Include="Avalonia.BuildServices" ExcludeAssets="all" />
  </ItemGroup>
</Project>
