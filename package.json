{
  "name": "folio",
  "version": "0.0.0",
  "private": true,
  "description": "A household budgeting app: monthly CSV review, with the data kept in a local file.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26.0.0",
    "npm": "^12.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --project tsconfig.json",
    "test:architecture": "depcruise --config .dependency-cruiser.cjs packages apps tests && vitest run --project architecture",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test": "npm run test:architecture && npm run test:unit && npm run test:integration && npm run test:e2e",
    "check:install-policy": "node scripts/check-install-policy.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:architecture"
  },
  "allowScripts": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.4.4",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
