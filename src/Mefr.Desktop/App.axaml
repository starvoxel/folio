<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Mefr.Desktop"
             x:Class="Mefr.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <!-- The theme is owned by Ui/Fluent (AD-15); screens only reference WinUI token keys. -->
    <StyleInclude Source="avares://Mefr.Desktop/Ui/Fluent/AppStyles.axaml" />
  </Application.Styles>
</Application>
