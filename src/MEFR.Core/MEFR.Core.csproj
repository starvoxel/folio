    All domain logic: model, classifier, commands, change sets, lock guard, undo, file format.
    Must never reference Avalonia, FluentAvalonia or MEFR.Desktop (AD-14; enforced by
    tests/MEFR.Core.Tests/Architecture/CoreDependencyTests.cs).
  -->
  <PropertyGroup>
    <RootNamespace>MEFR.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MEFR.Core.Tests" />
  </ItemGroup>
</Project>
