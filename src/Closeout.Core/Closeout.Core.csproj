<Project Sdk="Microsoft.NET.Sdk">
  <!--
    All domain logic: model, classifier, commands, change sets, lock guard, undo, file format.
    Must never reference Avalonia, FluentAvalonia or Closeout.Desktop (AD-14; enforced by
    tests/Closeout.Core.Tests/Architecture/CoreDependencyTests.cs).
  -->
  <PropertyGroup>
    <RootNamespace>Closeout.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Closeout.Core.Tests" />
  </ItemGroup>
</Project>
