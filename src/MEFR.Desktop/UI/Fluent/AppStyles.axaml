<!--
  The only place the app's theme is chosen (AD-15). FluentAvalonia types may appear only under UI/Fluent/.
  Screens reference WinUI token keys (TextFillColor*, *FillColor*, *StrokeColor*, ControlCornerRadius)
  through DynamicResource and never FluentAvalonia-specific keys, so a later move to Avalonia's
  Fluent2 theme keeps every screen's styling.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sty="using:FluentAvalonia.Styling">
  <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="False" CustomAccentColor="#0078D4" />
</Styles>
