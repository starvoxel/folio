<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Avalonia + FluentAvalonia views and view-models, plus thin platform adapters.
    FluentAvalonia types may only be used under UI/Fluent/ (AD-15; enforced by
    tests/MEFR.Desktop.Tests/Architecture/FluentIsolationTests.cs).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MEFR.Desktop</RootNamespace>
    <AssemblyName>MEFR.Desktop</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest Condition="Exists('app.manifest')">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MEFR.Core\MEFR.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MEFR.Desktop.Tests" />
  </ItemGroup>
</Project>
