<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Avalonia + FluentAvalonia views and view-models, plus thin platform adapters.
    FluentAvalonia types may only be used under UI/Fluent/ (AD-15; enforced by
    tests/Closeout.Desktop.Tests/Architecture/FluentIsolationTests.cs).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Closeout.Desktop</RootNamespace>
    <AssemblyName>Closeout.Desktop</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest Condition="Exists('app.manifest')">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Closeout.Core\Closeout.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Closeout.Desktop.Tests" />
  </ItemGroup>
</Project>
