{
  "name": "folio-electron-spike",
  "version": "0.0.1",
  "private": true,
  "description": "Folio stack-selection spike: Electron + TypeScript slice",
  "main": "dist/main/main.js",
  "license": "UNLICENSED",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.main.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "dev:ui": "vite",
    "start": "electron .",
    "package": "node scripts/package.mjs",
    "test": "playwright test",
    "test:unit": "node --test --experimental-strip-types src/shared/*.test.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "9.75.2",
    "@tanstack/react-virtual": "3.14.26",
    "echarts": "6.1.0",
    "electron": "45.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "ws": "8.22.2"
  }
}
