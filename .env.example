# Copy this file to `.env` in the folder you start the app from (normally the repository root).
# Only unpackaged runs read it; a packaged build ignores it. A variable that is already set in
# your shell wins over the file. Only the keys below are used; anything else in `.env` is ignored.

# How much the main process logs: debug, info, warn or error. The default is info.
FOLIO_LOG_LEVEL=debug

# Set to 1 to write the unredacted details (raw messages, raw stacks, private values) to the
# terminal and to logs-dev/folio-unredacted.log. Development only; never use real household data
# you would not want in a local file.
# FOLIO_LOG_UNREDACTED=1
