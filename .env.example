# Copy to .env in the repo root. Only `npm run dev` reads it, never a packaged build.

# debug, info, warn or error
FOLIO_LOG_LEVEL=debug

# Raw details to the terminal and logs-dev/folio-unredacted.log
# FOLIO_LOG_UNREDACTED=1

# Allow driving the app from the command line (AD-16)
# FOLIO_AUTOMATION=1
