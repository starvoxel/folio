# Enforces the csharp_base and csharp_avalonia standards (ai-foundation). EnforceCodeStyleInBuild and
# TreatWarningsAsErrors (Directory.Build.props) turn the warnings below into build failures.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,props,targets,csproj,slnx,axaml,xml,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.cs]
# Explicit types, never var
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0008.severity = warning

# Target-typed new and collection expressions
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# File-scoped namespaces only
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# No primary constructors
csharp_style_prefer_primary_constructors = false:warning
dotnet_diagnostic.IDE0290.severity = none

# Expression bodies only for single expressions
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_constructors = false:suggestion

# Explicit access modifiers
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_diagnostic.IDE0040.severity = warning

# Pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion

# using order: System first, then groups separated by a blank line
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true
csharp_using_directive_placement = outside_namespace:warning

# Braces always
csharp_prefer_braces = true:warning

# Naming
dotnet_naming_rule.interfaces_begin_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_i_style
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

# Naming violations fail the build, not just dotnet format
dotnet_diagnostic.IDE1006.severity = warning

# private static readonly fields are treated like constants: PascalCase
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly_symbols
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_style
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_symbols.private_static_readonly_symbols.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_symbols.required_modifiers = static, readonly

dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_field_symbols.required_modifiers =
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

dotnet_naming_rule.constants_pascal.symbols = constant_symbols
dotnet_naming_rule.constants_pascal.style = pascal_style
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_symbols.constant_symbols.applicable_kinds = field
dotnet_naming_symbols.constant_symbols.required_modifiers = const
dotnet_naming_style.pascal_style.capitalization = pascal_case

dotnet_naming_rule.async_methods_suffix.symbols = async_method_symbols
dotnet_naming_rule.async_methods_suffix.style = async_suffix_style
dotnet_naming_rule.async_methods_suffix.severity = warning
dotnet_naming_symbols.async_method_symbols.applicable_kinds = method
dotnet_naming_symbols.async_method_symbols.required_modifiers = async
dotnet_naming_style.async_suffix_style.required_suffix = Async
dotnet_naming_style.async_suffix_style.capitalization = pascal_case

# Tests: xUnit method names use Method_Scenario_Result, which the async-suffix rule would reject
[tests/**.cs]
dotnet_naming_rule.async_methods_suffix.severity = none
# CA1707 (no underscores in identifiers) conflicts with the test naming convention
dotnet_diagnostic.CA1707.severity = none
