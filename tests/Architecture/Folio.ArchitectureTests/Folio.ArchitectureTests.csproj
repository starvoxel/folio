<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Architecture tests (fitness functions): structural rules of the codebase itself, such as assembly
    references, where FluentAvalonia may appear, and the test layout and naming. They read assemblies,
    project files and sources, not app behaviour. Run with: dotnet test tests/Architecture.slnx
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Folio.ArchitectureTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Folio.Core\Folio.Core.csproj" />
  </ItemGroup>
</Project>
