  "regex": [
    {
      "category": "ing-phrase",
      "pattern": ",\\s+(?:highlighting|ensuring|reflecting|underscoring|showcasing|emphasizing|demonstrating|contributing to|fostering|enabling|allowing|making it|providing|offering|cementing|solidifying|paving)\\b[^.]*",
      "fix": "cut the trailing -ing clause or make it its own factual sentence"
    },
    {
      "category": "not-just",
      "pattern": "\\bnot (?:just|only|merely|simply)\\b[^.]{0,80}\\bbut (?:also )?\\b",
      "fix": "state the point directly"
    },
    {
      "category": "not-just",
      "pattern": "\\b(?:it|this|that)(?:'s| is) not (?:just |only |merely )?[^.,;]{1,60}[,;] (?:it|this|that)(?:'s| is)\\b",
      "fix": "state the point directly"
    },
    {
      "category": "em-dash",
      "pattern": "\\u2014|\\u2013| -- ",
      "fix": "use a period, comma, colon, or parentheses"
    },
    {
      "category": "curly-quote",
      "pattern": "[\\u2018\\u2019\\u201C\\u201D]",
      "fix": "use straight quotes"
    },
    {
      "category": "inline-header",
      "pattern": "^\\s*(?:[-*+]|\\d+\\.)\\s+\\*\\*[^*]+?:?\\*\\*:?\\s",
      "fix": "rewrite as prose; use an italic lead-in if a label is needed"
    },
    {
      "category": "bold",
      "pattern": "\\*\\*[^*]+\\*\\*",
      "fix": "bold only UI labels and critical warnings"
    },
    {
      "category": "emoji",
      "pattern": "[🌀-🫿⭐✅❌]",
      "fix": "remove decorative emoji"
    },
    {
      "category": "passive",
      "pattern": "\\b(?:is|are|was|were|been|being|be) (?:\\w+ly )?\\w+(?:ed|en) by\\b",
      "fix": "use active voice; name the actor"
    },
    {
      "category": "rule-of-three",
      "pattern": "\\b[a-z-]+, [a-z-]+,? and [a-z-]+\\b",
      "fix": "check that all three items exist; do not force triplets"
    },
    {
      "category": "adverb",
      "pattern": "\\b\\w+ly (?:fast|quick|slow|easy|simple|small|large|efficient)\\b|\\b(?:runs|works|moves|loads) (?:very |extremely )?(?:quickly|slowly|efficiently|seamlessly|effortlessly)\\b",
      "fix": "use a stronger verb or adjective ('is fast')"
    },
    {
      "category": "symbol-speak",
      "pattern": "(?:\\s->\\s|\\s=>\\s|\\s&\\s|\\s\\+\\s|\\bw/\\s|\\bw/o\\b|\\bvs\\.?\\s)",
      "fix": "spell out; avoid symbols the reader must decode"
    }
  ]
}
